#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Launch EDuke32 VR with the qualified gameplay features (EDUKE32_XR=play).
#
#   eduke32-vr-play [--aa AA_DIR] [--grp DUKE3D.GRP] [--left] [--no-models] [--release] [--glow] [--pack NAME]
#                   [--assets DUKE_VR_ASSETS] [--binary EDUKE32_XR] [-- eduke32 args]
#
# Stock Duke: pass --grp (or run where DUKE3D.GRP is found natively).
# Alien Armageddon 5.66: pass --aa with the install directory; the shipped
# eduke32_vr_aa566.con compatibility entry is selected automatically.
# Model packs are ordinary mods: every pack in the sibling duke-vr-assets checkout is built into
# ~/.local/share/eduke32-vr/vrpacks/<name>/ (build_vr_pack.py), where the game finds it; the game
# loads the one chosen in Options > VR Setup (saved in its config), --pack NAME for this run, or
# your launcher.conf "pack=NAME" default. --no-models loads none (native 2D sprites). --release
# builds only redistributable packs. Installed game data is never modified.
# Any EDUKE32_XR_* variable you export still overrides the preset.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../.." && pwd)
binary="$repo/eduke32-xr"
assets="$(cd "$repo/.." && pwd)/duke-vr-assets"
aa="" grp="" models=1 release="" glow="" pack="" default_pack=""
# Personal defaults (never shipped): ~/.config/eduke32-vr/launcher.conf, e.g. "pack=dnf-private".
# It is only the default; the pack chosen in the game's VR Setup menu wins.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/eduke32-vr/launcher.conf"
[[ -f $conf ]] && default_pack=$(sed -n 's/^pack=//p' "$conf" | tail -1)
args=()
while (($#)); do
    case "$1" in
        --aa) aa=$(cd "$2" && pwd); shift 2 ;;
        --grp) grp=$(realpath "$2"); shift 2 ;;
        --left) export EDUKE32_XR_AIM="${EDUKE32_XR_AIM:-left}"; shift ;;
        --no-models) models=0; shift ;;
        --release) release=1; shift ;;
        --glow) glow=1; shift ;;
        --pack) pack=$2; shift 2 ;;
        --assets) assets=$(cd "$2" && pwd); shift 2 ;;
        --binary) binary=$(realpath "$2"); shift 2 ;;
        --) shift; args+=("$@"); break ;;
        -h|--help) sed -n '3,14p' "$0"; exit 0 ;;
        *) args+=("$1"); shift ;;
    esac
done
[[ -x "$binary" ]] || { echo "eduke32-vr-play: build $binary first (make USE_OPENXR=1 ...)" >&2; exit 1; }

export EDUKE32_VR_HERE="$here"
root="${XDG_DATA_HOME:-$HOME/.local/share}/eduke32-vr"
packs="$root/vrpacks" local="$root/local/$([[ -n $aa ]] && echo aa566 || echo duke3d)"
mkdir -p "$packs" "$local"

# Pack names: a pack.json "name" (e.g. "original") or its duke-vr-assets folder (e.g. v7-original).
pack_name() {
    local entry
    for entry in "${pack_list[@]}"; do
        IFS='=' read -r name title dir <<< "$entry"
        [[ $1 == "$name" || $1 == "$dir" ]] && { echo "$name"; return; }
    done
    echo "$1"
}

# Builds every installed pack (quick: symlinks into the asset folders) and the local extras.
prepare() {
    pack_list=()
    if ((models)) && [[ -d $assets ]]; then
        mapfile -t pack_list < <(python3 "$here/build_vr_def.py" "$assets" --list-packs ${release:+--release})
        local entry
        for entry in "${pack_list[@]}"; do
            IFS='=' read -r name title dir <<< "$entry"
            python3 "$here/build_vr_pack.py" "$assets" "$dir" "$packs" ${release:+--release} ${glow:+--glow} > /dev/null
        done
    fi
    # Tipping: a wad of bills cut from the MONEY art of the user's own GRP (AA.grp, the stock GRP,
    # or a DUKE3D.GRP in the working directory); not part of any pack.
    art_grp=$grp
    [[ -z $art_grp ]] && art_grp=$(find . -maxdepth 1 -iname duke3d.grp -print -quit 2>/dev/null)
    python3 - "$local" ${aa:+"$aa/AA.grp"} ${art_grp:+"$(realpath "$art_grp")"} <<'PY'
import os, sys
from pathlib import Path
sys.path.insert(0, os.environ['EDUKE32_VR_HERE'])
import money_wad
out = Path(sys.argv[1])
text = '// Generated by eduke32-vr-play: local extras (not a model pack); safe to delete.\n'
if money_wad.build(sys.argv[2:], out):
    text += ('model "vr_money.md3" {\n scale 1.0\n skin { pal 0 surface 0 file "vr_money.png" }\n'
             ' frame { name "rest" tile 30068 smoothduration 0 }\n}\n')
(out / 'vr-local.def').write_text(text)
PY

    cmd=("$binary" -j "$root" -j "$local" -mh vr-local.def)
    if ((!models)); then
        cmd+=(-vrpack none)
    elif [[ -n $pack ]]; then
        cmd+=(-vrpack "$(pack_name "$pack")")
    fi
    [[ -n $default_pack ]] && export EDUKE32_XR_DEFAULT_PACK="$(pack_name "$default_pack")"
    if [[ -n $aa ]]; then
        cmd+=(-j "$aa" -j "$here/aa566" -g "$aa/AA.grp" -x eduke32_vr_aa566.con)
    fi
    # EDuke32 matches -gamegrp against the scanned GRP names, so pass a bare name
    # (a full path never matches and silently falls back to the first GRP found,
    # e.g. an add-on like vacation.grp). Expose only the GRP itself through a
    # private directory: install folders such as World Tour's hold loose GAME.CON
    # and maps/ that would otherwise override the GRP's own.
    if [[ -n $grp ]]; then
        mkdir -p "$local/grp"
        ln -sfn "$grp" "$local/grp/$(basename "$grp")"
        cmd+=(-j "$local/grp" -gamegrp "$(basename "$grp")")
    fi
    cmd+=(-nosetup "${args[@]}")
}

export EDUKE32_XR="${EDUKE32_XR:-play}"
# The headset needs an X11 (XWayland) GL window, and the setup dialog would
# wait on the desktop; -setup in the EDuke32 arguments still shows it.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
# The headset paces frames: the desktop mirror must never wait on the monitor (a vsync forced
# in nvidia-settings), and the stereo collector reads GL state back per draw, which a threaded
# GL driver turns into a queue drain each time.
export __GL_SYNC_TO_VBLANK="${__GL_SYNC_TO_VBLANK:-0}" __GL_THREADED_OPTIMIZATIONS="${__GL_THREADED_OPTIMIZATIONS:-0}"
export mesa_glthread="${mesa_glthread:-false}"

# A model set chosen in the game's VR Setup menu asks for a restart: the game saves its choice,
# writes this file and quits, and the next round loads it (a --pack given for the first run no
# longer applies).
restart=$(mktemp -t eduke32-vr-restart.XXXXXX)
trap 'rm -f "$restart"' EXIT
export EDUKE32_XR_RESTART_REQUEST="$restart"
while :; do
    prepare
    : > "$restart"
    status=0
    "${cmd[@]}" || status=$?
    [[ -s $restart ]] || exit "$status"
    echo "eduke32-vr-play: restarting with model set $(head -n1 "$restart")" >&2
    pack=""
done
