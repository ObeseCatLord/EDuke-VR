#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Launch EDuke32 VR with the qualified gameplay features (EDUKE32_XR=play).
#
#   eduke32-vr-play [--aa AA_DIR] [--grp DUKE3D.GRP] [--left] [--no-models] [--release] [--glow] [--pack NAME]
#                   [--assets DUKE_VR_ASSETS] [--binary EDUKE32_XR] [-- eduke32 args]
#
# Stock Duke: pass --grp (or run where DUKE3D.GRP is found natively).
# Alien Armageddon 5.66: pass --aa with the install directory; the shipped
# eduke32_vr_aa566.con compatibility entry is selected automatically.
# Held weapon/hand/body models come from the sibling duke-vr-assets packages and
# are linked into a private directory; installed game data is never modified.
# Original v6 assets are preferred; --release refuses the older packages that
# derive from commercial game data (see build_vr_def.py).
# Any EDUKE32_XR_* variable you export still overrides the preset.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../.." && pwd)
binary="$repo/eduke32-xr"
assets="$(cd "$repo/.." && pwd)/duke-vr-assets"
aa="" grp="" models=1 release="" glow="" pack=""
# Personal defaults (never shipped): ~/.config/eduke32-vr/launcher.conf, e.g. "pack=dnf-private".
conf="${XDG_CONFIG_HOME:-$HOME/.config}/eduke32-vr/launcher.conf"
[[ -f $conf ]] && pack=$(sed -n 's/^pack=//p' "$conf" | tail -1)
args=()
while (($#)); do
    case "$1" in
        --aa) aa=$(cd "$2" && pwd); shift 2 ;;
        --grp) grp=$(realpath "$2"); shift 2 ;;
        --left) export EDUKE32_XR_AIM="${EDUKE32_XR_AIM:-left}"; shift ;;
        --no-models) models=0; shift ;;
        --release) release=1; shift ;;
        --glow) glow=1; shift ;;
        --pack) pack=$2; shift 2 ;;
        --assets) assets=$(cd "$2" && pwd); shift 2 ;;
        --binary) binary=$(realpath "$2"); shift 2 ;;
        --) shift; args+=("$@"); break ;;
        -h|--help) sed -n '3,14p' "$0"; exit 0 ;;
        *) args+=("$1"); shift ;;
    esac
done
[[ -x "$binary" ]] || { echo "eduke32-vr-play: build $binary first (make USE_OPENXR=1 ...)" >&2; exit 1; }

[[ $pack == v6-original ]] && pack=""
data="${XDG_DATA_HOME:-$HOME/.local/share}/eduke32-vr/${pack:+$pack/}$([[ -n $aa ]] && echo aa566 || echo duke3d)"
mkdir -p "$data"
def="$data/eduke32-vr-models.def"
{
    echo '// Generated by eduke32-vr-play; safe to delete.'
    [[ -n $aa ]] && echo 'include "duke3d.def"'
} > "$def"

if ((models)) && [[ -d $assets ]]; then
    python3 "$here/build_vr_def.py" "$assets" "$data" ${aa:+--aa} ${release:+--release} ${glow:+--glow} ${pack:+--pack=$pack} >> "$def"
    # A pack may ask for unfiltered (nearest) model textures.
    [[ $(cat "$data/pack-filter.txt" 2>/dev/null) == nearest ]] && export EDUKE32_XR_MODEL_FILTER="${EDUKE32_XR_MODEL_FILTER:-nearest}"
    export EDUKE32_XR_HAND_RIG="${EDUKE32_XR_HAND_RIG:-$data/hand-rig.txt}"
    [[ -n $aa ]] && export EDUKE32_XR_HUD_MODEL_MAP="${EDUKE32_XR_HUD_MODEL_MAP:-$data/hud-model-map.txt}"
fi

export EDUKE32_XR="${EDUKE32_XR:-play}"
cmd=("$binary" -j "$data")
if [[ -n $aa ]]; then
    cmd+=(-j "$aa" -j "$here/aa566" -g "$aa/AA.grp" -x eduke32_vr_aa566.con)
fi
# EDuke32 matches -gamegrp against the scanned GRP names, so pass a bare name
# (a full path never matches and silently falls back to the first GRP found,
# e.g. an add-on like vacation.grp). Expose only the GRP itself through a
# private directory: install folders such as World Tour's hold loose GAME.CON
# and maps/ that would otherwise override the GRP's own.
if [[ -n $grp ]]; then
    mkdir -p "$data/grp"
    ln -sfn "$grp" "$data/grp/$(basename "$grp")"
    cmd+=(-j "$data/grp" -gamegrp "$(basename "$grp")")
fi
# The headset needs an X11 (XWayland) GL window, and the setup dialog would
# wait on the desktop; -setup in the EDuke32 arguments still shows it.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
cmd+=(-nosetup -h eduke32-vr-models.def "${args[@]}")
exec "${cmd[@]}"
